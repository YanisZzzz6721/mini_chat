# Copie ce fichier en .env.local (il est ignoré par Git) et remplis-le. Ne le commite jamais.

# Code d'accès à l'appli (6 caractères minimum). Sans cette ligne, lancer.sh le demande à chaque fois.
CODE=

# --- E-mails automatiques (facultatif) ---
# Reçoit le lien d'accès à chaque nouveau lien, sans détails techniques. Jamais le code d'accès.
MAIL_TO_USER=prenom.nom@exemple.fr
# Reçoit les alertes techniques détaillées (tunnel relancé, serveur en panne, Claude déconnecté…).
MAIL_TO_ADMIN=toi@exemple.fr

# Compte qui ENVOIE les mails. Exemple Gmail : active la validation en 2 étapes, puis crée un
# « mot de passe d'application » (https://myaccount.google.com/apppasswords). Pas ton mot de passe habituel.
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USER=toi@gmail.com
SMTP_PASS=
# MAIL_FROM=toi@gmail.com

# --- Réglages avancés (facultatif) ---
# PORT=3000
# CLAUDE_BIN=/chemin/vers/claude
# CLAUDE_TIMEOUT_S=240
# MAIL_DRY_RUN=1     # écrit les mails dans logs/mails-test.txt au lieu de les envoyer
